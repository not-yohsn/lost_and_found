FLASK_APP=run.py
FLASK_DEBUG=1
SECRET_KEY=change-me-in-production

# Local DB (XAMPP). On Render set these to your TiDB Cloud values + DB_SSL=1.
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lost_and_found
DB_SSL=0

UPLOAD_FOLDER=app/static/uploads
MAX_CONTENT_LENGTH=3145728

# Email — leave MAIL_SERVER blank to disable email (in-app notifications still work).
# For Gmail: use an App Password (Google Account → Security → 2FA → App passwords).
# For testing: sign up at https://mailtrap.io/ and use their SMTP creds.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Lost & Found <noreply@lostandfound.local>
